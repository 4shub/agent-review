{
  "name": "code-review",
  "version": "0.1.0",
  "description": "Super lightweight CLI-based code review tool with GitHub-like UI for AI coding agents",
  "main": "dist/cli/index.js",
  "type": "module",
  "bin": {
    "code-review": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "node --loader ts-node/esm src/cli/index.ts",
    "build": "node esbuild.config.js",
    "build:watch": "node esbuild.config.js --watch",
    "test": "vitest",
    "test:unit": "vitest run --reporter=verbose",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "code-review",
    "git",
    "diff",
    "cli",
    "ai",
    "coding-agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/static": "^6.12.0",
    "@preact/signals": "^2.6.2",
    "commander": "^11.1.0",
    "fastify": "^4.26.0",
    "open": "^10.0.3",
    "preact": "^10.19.3",
    "shiki": "^3.22.0",
    "simple-git": "^3.22.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/preact": "^3.2.3",
    "@types/node": "^20.11.5",
    "@vitest/coverage-v8": "^1.2.0",
    "esbuild": "^0.19.12",
    "jsdom": "^24.0.0",
    "msw": "^2.0.0",
    "playwright": "^1.41.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
